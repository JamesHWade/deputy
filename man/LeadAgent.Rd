\subsection{\code{LeadAgent$parallel_delegate()}}{
  Ask several subagents for one reply each, in parallel.

Each named definition gets a fresh conversation, no tools and at most
one model request, so definitions with tools, skills or \code{mcp_servers}
are rejected. The lead's conversation is not changed.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{LeadAgent$parallel_delegate(
  tasks,
  max_active = 2L,
  mode = "stateless",
  usage_limits = NULL,
  run_context = list()
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{tasks}}{A named character vector, or a named list of strings and
\link{DelegationInput} objects. Each name selects a different registered
definition.}
      \item{\code{max_active}}{Maximum number of subagents running at once.}
      \item{\code{mode}}{Only \code{"stateless"} is supported.}
      \item{\code{usage_limits}}{Optional \link{UsageLimits} for the whole batch; unset
fields use the lead's. Token and cost limits are split between the
subagents running at once and checked after each reply, so the batch
can overshoot by one reply per running subagent.}
      \item{\code{run_context}}{Named list added to the lead's \code{run_context} for this
batch.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A list with \code{mode}, \code{results} (\link{AgentResult} objects, \code{NULL}
where none was returned), \code{outcomes} (\link{DelegationOutcome} objects),
\code{errors}, \code{status}, and \code{run}, an \link{AgentResult} for the whole batch
that \verb{$last_run()} also returns. Entries follow the order of \code{tasks},
including failed and unstarted ones; a failure doesn't discard the
other results.
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-LeadAgent-parallel_delegate_async"></a>}}
\if{latex}{\out{\hypertarget{method-LeadAgent-parallel_delegate_async}{}}}
\subsection{\code{LeadAgent$parallel_delegate_async()}}{
  Version of \verb{$parallel_delegate()} that doesn't block R.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{LeadAgent$parallel_delegate_async(
  tasks,
  max_active = 2L,
  mode = "stateless",
  usage_limits = NULL,
  run_context = list()
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{tasks, max_active, mode, usage_limits, run_context}}{See
\verb{$parallel_delegate()}.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A promise that resolves to the same list as
\verb{$parallel_delegate()}. Calling \verb{$interrupt()} cancels tasks that
haven't started and asks running subagents to stop.
  }
}

