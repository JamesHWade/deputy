\subsection{\code{LeadAgent$new()}}{
  Create a new LeadAgent.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{LeadAgent$new(
  chat,
  sub_agents = list(),
  tools = list(),
  system_prompt = NULL,
  permissions = NULL,
  usage_limits = NULL,
  context_policy = ContextPolicy(),
  enable_file_checkpointing = FALSE,
  file_checkpoint_max_file_bytes = 50 * 1024^2,
  file_checkpoint_max_journal_bytes = 250 * 1024^2,
  working_dir = getwd(),
  session_id = NULL,
  run_context = list(),
  agent_id = NULL,
  agent_name = NULL,
  fallback_chats = list(),
  delegation_sources = list(),
  delegation_scope = list(),
  delegation_max_bytes = 65536L,
  delegation_policy = DelegationPolicy(),
  delegation_disclosure = DelegationDisclosure(),
  delegation_observation = DelegationObservation(),
  approval_dir = NULL,
  trusted_results = NULL
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{chat}}{An ellmer \code{Chat} for the lead.}
      \item{\code{sub_agents}}{A list of \code{\link[=agent_definition]{agent_definition()}} objects.}
      \item{\code{tools}}{Tools for the lead, in addition to \code{delegate_to_agent}.}
      \item{\code{system_prompt}}{System prompt for the lead; a list of the
subagents is appended.}
      \item{\code{permissions}}{\link{Permissions} for the lead and, by default, its
subagents. A definition can only narrow them.}
      \item{\code{usage_limits}}{\link{UsageLimits} for each lead run, shared with the
subagents it starts.}
      \item{\code{context_policy}}{A \link{ContextPolicy} for compaction and large tool
results, used by the lead and its subagents.}
      \item{\code{enable_file_checkpointing}}{Whether to checkpoint files before
Deputy's file tools change them, so changes can be rewound. The lead
and its subagents share the checkpoints.}
      \item{\code{file_checkpoint_max_file_bytes}}{Maximum size, in bytes, of one file
saved in a checkpoint. Defaults to 50 MiB.}
      \item{\code{file_checkpoint_max_journal_bytes}}{Maximum total size, in bytes, of
all checkpoint data. Defaults to 250 MiB.}
      \item{\code{working_dir}}{Working directory, shared with subagents.}
      \item{\code{session_id}}{Optional session ID, generated by default.}
      \item{\code{run_context}}{Named list of JSON-compatible values, such as a user
ID, attached to every run of the lead and its subagents.}
      \item{\code{agent_id}}{Optional ID for the lead, generated by default.}
      \item{\code{agent_name}}{Optional display name for the lead.}
      \item{\code{fallback_chats}}{Chats to switch to, in order, if the lead's
provider fails; see \link{Agent}. Subagents have no fallbacks; those that
inherit the lead's model use its current chat.}
      \item{\code{delegation_sources}}{Text sources that tasks can cite as evidence
(see \link{DelegationInput}): an unnamed list of up to 128 records, 16 MiB in
total, each with \code{source_id}, \code{revision}, \code{owner_id}, \code{conversation_id}
and \code{text}, and optionally \code{allowed_agents}, the definitions that may
receive it (\code{NULL} for all). Each \code{source_id} may have one revision per
owner and conversation. Deputy checks the scope and revision, not
whether the user may see a source, so include only sources they may see.}
      \item{\code{delegation_scope}}{A list with \code{owner_id} and \code{conversation_id},
required with \code{delegation_sources}. Only sources with the same owner and
conversation can be used, and the model can't change it. It is also
passed to the \link{DelegationDisclosure} \code{authorize} function.}
      \item{\code{delegation_max_bytes}}{Size limit, in bytes, checked separately for
a delegation's task, evidence, starting prompt and message, and
\link{DelegationManifest}. Defaults to 64 KiB. A delegation over this limit,
or whose estimated tokens exceed the \link{ContextPolicy} \code{max_tokens},
fails before any model request.}
      \item{\code{delegation_policy}}{A \link{DelegationPolicy} for subagent tools, hooks
and user questions.}
      \item{\code{delegation_disclosure}}{A \link{DelegationDisclosure} that decides who may
inspect subagents and their history. The default denies everyone.}
      \item{\code{delegation_observation}}{A \link{DelegationObservation} setting the size
of the event buffer read by \verb{$observe_subagents()}.}
      \item{\code{approval_dir}}{Optional directory for durable tool approvals; see
\link{Agent}. A lead with \code{approval_dir} set can't delegate.}
      \item{\code{trusted_results}}{Optional \link{TrustedResults} policy that also covers
every subagent and its tools. A designated tool may belong to the lead
or a subagent, but must be the same tool everywhere. Subagents' trusted
results are recorded in the lead's run and passed to its \code{on_result}.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A new \code{LeadAgent} object
  }
}

